# Trustchain Escrow — Backend Environment Variables
# Copy this file to `.env` and fill in real values. Variables marked
# `# SENSITIVE` must never be committed with real values.

# ── Secrets Management ────────────────────────────────────────────────────────
# Backend used to resolve secrets. "env" (default) reads process.env directly;
# "vault" (production) resolves secrets from HashiCorp Vault at runtime.
# Format: "env" | "vault" | Required: no (default: env)
SECRETS_BACKEND=env

# HashiCorp Vault address. Required only when SECRETS_BACKEND=vault.
# Format: URL | Required: conditional
VAULT_ADDR=http://127.0.0.1:8200
# Vault AppRole Role ID (preferred auth method for production).
# Format: string | Required: conditional (SECRETS_BACKEND=vault, AppRole auth)
VAULT_ROLE_ID=
# Vault AppRole Secret ID. # SENSITIVE — do not commit real values.
# Format: string | Required: conditional (SECRETS_BACKEND=vault, AppRole auth)
VAULT_SECRET_ID=
# Static Vault token — dev/CI only, use AppRole in production. # SENSITIVE
# Format: string | Required: no
VAULT_TOKEN=
# KV v2 path where application secrets are stored in Vault.
# Format: path | Required: conditional (SECRETS_BACKEND=vault) | Default: stellar-trust/app
VAULT_KV_PATH=stellar-trust/app
# Vault Enterprise namespace. Leave blank for Vault OSS.
# Format: string | Required: no
VAULT_NAMESPACE=
# How long to cache resolved secrets in-process before re-fetching from Vault.
# Format: integer (ms) | Required: no | Default: 300000 (5 min)
SECRETS_CACHE_TTL_MS=300000
# How often to auto-rotate/refresh cached secrets from Vault.
# Format: integer (ms) | Required: no | Default: 3600000 (1 hour)
SECRETS_ROTATION_INTERVAL_MS=3600000

# ── Server ─────────────────────────────────────────────────────────────────────
# HTTP port the Express API listens on.
# Format: integer | Required: no | Default: 4000
PORT=4000
# Node/runtime environment. Controls logging verbosity, error detail exposure,
# and default rate/sample settings elsewhere in this file.
# Format: "development" | "test" | "production" | Required: no | Default: development
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
# Primary PostgreSQL connection string used by Prisma (pooled). Includes
# optional pooling params: connection_limit (default: 10), pool_timeout
# (0 = no timeout), connect_timeout (default: 60000ms, seconds in the URL).
# Format: postgresql:// URL | Required: yes # SENSITIVE — contains DB credentials
DATABASE_URL=postgresql://user:password@localhost:5432/stellar_escrow
# Direct (non-pooled) PostgreSQL connection used by `prisma migrate`. In local
# development this can be identical to DATABASE_URL unless a separate
# non-pooled connection is available.
# Format: postgresql:// URL | Required: yes # SENSITIVE — contains DB credentials
DIRECT_URL=postgresql://user:password@localhost:5432/stellar_escrow

# ── Stellar / Soroban ──────────────────────────────────────────────────────────
# Stellar network to target.
# Format: "testnet" | "mainnet" | "futurenet" | Required: no | Default: testnet
STELLAR_NETWORK=testnet
# Deployed Soroban contract address for the active network (legacy alias of
# ESCROW_CONTRACT_ID below — kept for backward compatibility).
# Format: Soroban contract ID (C...) | Required: yes
CONTRACT_ADDRESS=
# Soroban RPC endpoint used for contract reads/writes and event ingestion.
# Format: URL | Required: yes | Default: https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Stellar Horizon endpoint used for classic-ledger queries (account/tx lookups).
# Format: URL | Required: yes | Default: https://horizon-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Network passphrase — must match the network SOROBAN_RPC_URL actually serves,
# or signed transactions will be rejected.
# Format: string | Required: yes | Default: "Test SDF Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# The deployed escrow contract ID. Used by the relayer, the event indexer, and
# for verifying on-chain transaction payloads.
# Format: Soroban contract ID (C...) | Required: yes
ESCROW_CONTRACT_ID=

# ── Multi-Tenancy ──────────────────────────────────────────────────────────────
# Tenant ID seeded/used when no explicit X-Tenant-ID header is provided.
# Format: string | Required: no | Default: tenant_default
DEFAULT_TENANT_ID=tenant_default
# Slug for the default tenant (used in URLs/lookups).
# Format: string | Required: no | Default: default
DEFAULT_TENANT_SLUG=default
# Human-readable display name for the default tenant.
# Format: string | Required: no | Default: "Default Tenant"
DEFAULT_TENANT_NAME=Default Tenant

# ── Email ──────────────────────────────────────────────────────────────────────
# Email delivery provider. "console" logs emails locally instead of sending.
# Format: "console" | "sendgrid" | Required: no | Default: console
EMAIL_PROVIDER=console
# "From" address used on outbound transactional email.
# Format: email address | Required: yes | Default: no-reply@example.com
EMAIL_FROM=no-reply@example.com
# "From" display name used on outbound transactional email.
# Format: string | Required: no | Default: "Stellar Trust Escrow"
EMAIL_FROM_NAME=Stellar Trust Escrow
# Base URL used to build absolute links (e.g. unsubscribe, verification) in
# outbound emails.
# Format: URL | Required: yes | Default: http://localhost:4000
EMAIL_BASE_URL=http://localhost:4000
# Max emails sent per minute before the outbound queue throttles.
# Format: integer | Required: no | Default: 20
EMAIL_RATE_LIMIT_PER_MINUTE=20
# Max retry attempts for a failed email send before it's marked dead-lettered.
# Format: integer | Required: no | Default: 3
EMAIL_MAX_RETRIES=3
# Base delay before the first retry of a failed email send (backs off from here).
# Format: integer (ms) | Required: no | Default: 15000
EMAIL_RETRY_BASE_DELAY_MS=15000
# Polling interval for the outbound email queue worker.
# Format: integer (ms) | Required: no | Default: 5000
EMAIL_QUEUE_POLL_INTERVAL_MS=5000
# Secret used to sign one-click unsubscribe links. # SENSITIVE
# Format: string, ≥ 32 chars recommended | Required: yes
EMAIL_UNSUBSCRIBE_SECRET=change_this_secret
# SendGrid API key. Required only when EMAIL_PROVIDER=sendgrid. # SENSITIVE
# Format: string | Required: conditional
SENDGRID_API_KEY=

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# All JWT secrets below are REQUIRED, must be distinct from one another, and
# ≥ 32 chars (validated at startup by config/secrets.js and in CI by
# scripts/check-env.js). Generate each one separately: `openssl rand -hex 32`.
#
# Primary/legacy JWT signing secret. # SENSITIVE
# Format: string, ≥ 32 chars | Required: yes
JWT_SECRET=change_this_in_production
# Secret used to sign short-lived access tokens. # SENSITIVE
# Format: string, ≥ 32 chars, distinct from JWT_SECRET | Required: yes
JWT_ACCESS_SECRET=change_this_in_production_access
# Secret used to sign long-lived refresh tokens. # SENSITIVE
# Format: string, ≥ 32 chars, distinct from the above | Required: yes
JWT_REFRESH_SECRET=change_this_in_production_refresh
# Secret used to sign multi-factor step-up tokens (returned via the
# `x-mfa-token` header flow). # SENSITIVE
# Format: string, ≥ 32 chars, distinct from the above | Required: yes
MFA_JWT_SECRET=change_this_in_production_mfa
# Secret used to sign short-lived admin session tokens issued by
# POST /api/admin/auth/login. # SENSITIVE
# Format: string, ≥ 32 chars, distinct from the above | Required: yes
ADMIN_JWT_SECRET=change_this_in_production_admin
# Access token lifetime.
# Format: zeit/ms duration string | Required: no | Default: 15m
JWT_ACCESS_EXPIRATION=15m
# Refresh token lifetime.
# Format: zeit/ms duration string | Required: no | Default: 7d
JWT_REFRESH_EXPIRATION=7d
# Admin API key used to obtain an admin session token. # SENSITIVE
# Format: string | Required: yes | Generate with: openssl rand -hex 32
ADMIN_API_KEY=change_this_to_a_strong_random_secret
# Lifetime of issued admin session tokens.
# Format: zeit/ms duration string | Required: no | Default: 15m
ADMIN_TOKEN_TTL=15m

# ── Platform ───────────────────────────────────────────────────────────────────
# Protocol fee percentage charged on escrow volume.
# Format: decimal number (percent) | Required: no | Default: 1.5
PLATFORM_FEE_PERCENT=1.5
# Comma-separated list of origins allowed by CORS.
# Format: comma-separated URLs | Required: yes | Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Meta-Transactions / Relayer ────────────────────────────────────────────────
# Stellar secret key funding the gasless-transaction relayer. # SENSITIVE
# Format: Stellar secret key (S...) | Required: yes, for gasless transactions
RELAYER_SECRET_KEY=

# ── Redis ──────────────────────────────────────────────────────────────────────
# Redis connection string used for rate limiting, caching, and BullMQ queues.
# Falls back to an in-memory cache if unset (not suitable for multi-instance
# deployments).
# Format: redis:// URL | Required: no (recommended in production) | Default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Public API Rate Limiting ───────────────────────────────────────────────────
# Rate limit window size.
# Format: integer (ms) | Required: no | Default: 60000 (1 minute)
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
# Max requests per IP per window.
# Format: integer | Required: no | Default: 100
PUBLIC_RATE_LIMIT_IP_MAX=100
# Max requests per Stellar wallet address per window.
# Format: integer | Required: no | Default: 50
PUBLIC_RATE_LIMIT_WALLET_MAX=50
# Comma-separated IPs that bypass rate limiting (localhost is always exempt).
# Format: comma-separated IPs | Required: no | Example: RATE_LIMIT_WHITELIST_IPS=10.0.0.1,10.0.0.2
RATE_LIMIT_WHITELIST_IPS=

# ── Elasticsearch ──────────────────────────────────────────────────────────────
# Elasticsearch endpoint used for the escrow/proposal/user search index.
# Format: URL | Required: yes, for search | Local: http://localhost:9200 | Elastic Cloud: https://<deployment>.es.io
ELASTICSEARCH_URL=http://localhost:9200
# API key for Elastic Cloud or a secured cluster. Leave blank for local dev. # SENSITIVE
# Format: string | Required: conditional
ELASTICSEARCH_API_KEY=

# ── Event Indexer ──────────────────────────────────────────────────────────────
# Polling interval for the Soroban event indexer.
# Format: integer (ms) | Required: no | Default: 5000
INDEXER_POLL_INTERVAL_MS=5000
# Ledger sequence to start indexing from (0 = from contract genesis/current tip
# depending on indexer implementation).
# Format: integer | Required: no | Default: 0
INDEXER_START_LEDGER=0

# ── Logging ────────────────────────────────────────────────────────────────────
# Pino log level.
# Format: "debug" | "info" | "warn" | "error" | Required: no | Default: info
LOG_LEVEL=info
# Directory log files are written to.
# Format: path | Required: no | Default: logs
LOG_DIR=logs
# Log file name within LOG_DIR.
# Format: string | Required: no | Default: api.log
LOG_FILE_NAME=api.log
# Log rotation cadence.
# Format: duration string | Required: no | Default: 1d
LOG_ROTATION_PERIOD=1d
# Max size of a single log file before rotation.
# Format: size string | Required: no | Default: 1G
LOG_ROTATION_MAX_SIZE=1G
# Days to retain rotated log files before deletion.
# Format: integer (days) | Required: no | Default: 30
LOG_RETENTION_DAYS=30

# ── Sentry Error Tracking ──────────────────────────────────────────────────────
# Sentry DSN. Get it from https://sentry.io → Project Settings → Client Keys. # SENSITIVE
# Format: URL | Required: no (error tracking disabled if unset)
SENTRY_DSN=
# Environment tag attached to reported events.
# Format: string | Required: no | Default: development
SENTRY_ENVIRONMENT=development
# Release identifier attached to reported events, for release tracking.
# Format: git SHA or semver tag | Required: no
SENTRY_RELEASE=
# Fraction of transactions to trace for performance monitoring.
# Format: decimal 0.0–1.0 | Required: no | Default: 0.1 in prod, 1.0 in dev
SENTRY_TRACES_SAMPLE_RATE=

# ── KYC — Sumsub ───────────────────────────────────────────────────────────────
# See https://developers.sumsub.com for how to obtain these credentials.
# Sumsub application token. # SENSITIVE
# Format: string | Required: yes, for KYC
SUMSUB_APP_TOKEN=
# Sumsub secret key used to sign API requests. # SENSITIVE
# Format: string | Required: yes, for KYC
SUMSUB_SECRET_KEY=
# Sumsub API base URL.
# Format: URL | Required: no | Default: https://api.sumsub.com
SUMSUB_BASE_URL=https://api.sumsub.com
# Sumsub verification level name configured in the Sumsub dashboard.
# Format: string | Required: yes, for KYC | Default: basic-kyc-level
SUMSUB_LEVEL_NAME=basic-kyc-level

# ── Payments — Stripe ──────────────────────────────────────────────────────────
# See https://stripe.com/docs/keys for how to obtain these credentials.
# Stripe secret API key. # SENSITIVE
# Format: string (sk_...) | Required: yes, for fiat payments
STRIPE_SECRET_KEY=
# Stripe webhook signing secret, used to verify inbound Stripe webhook payloads. # SENSITIVE
# Format: string (whsec_...) | Required: yes, for fiat payments
STRIPE_WEBHOOK_SECRET=
# Frontend base URL, used to build Stripe redirect URLs after checkout.
# Format: URL | Required: yes | Default: http://localhost:3000
FRONTEND_URL=http://localhost:3000
# USDC issuer account on Stellar.
# Format: Stellar account ID (G...) | Required: yes | Mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
USDC_ISSUER=

# ── Performance Monitoring ─────────────────────────────────────────────────────
# Requests slower than this are flagged as slow in logs/metrics.
# Format: integer (ms) | Required: no | Default: 500
SLOW_REQUEST_THRESHOLD_MS=500
# Database queries slower than this are flagged as slow in logs/metrics.
# Format: integer (ms) | Required: no | Default: 200
SLOW_QUERY_THRESHOLD_MS=200
# Bearer token required to access the /metrics endpoint. # SENSITIVE
# Format: string | Required: no (metrics endpoint unprotected if unset)
METRICS_TOKEN=

# ── Backup & Point-In-Time Recovery ────────────────────────────────────────────
# Local directory where pg_dump backup files are stored.
# Format: path | Required: no | Default: /var/backups/stellar-trust
BACKUP_DIR=/var/backups/stellar-trust
# Days to retain local backup files before deletion.
# Format: integer (days) | Required: no | Default: 7
BACKUP_RETENTION_DAYS=7
# S3 destination for offsite backup copies.
# Format: s3:// URI | Required: no (recommended in production) | Example: s3://your-bucket/stellar-trust
BACKUP_S3_BUCKET=s3://your-bucket/stellar-trust
# Local directory PostgreSQL archives WAL segments to for point-in-time recovery.
# Format: path | Required: no, for PITR | Default: /var/lib/postgresql/wal_archive
WAL_ARCHIVE_DIR=/var/lib/postgresql/wal_archive
# S3 destination for offsite WAL archive copies.
# Format: s3:// URI | Required: no, for PITR | Example: s3://your-bucket/stellar-trust/wal
WAL_ARCHIVE_S3_BUCKET=s3://your-bucket/stellar-trust/wal
# Server-side encryption algorithm applied to backup/WAL objects in S3.
# Format: "AES256" | "aws:kms" | Required: no | Default: AES256
S3_SSE_ALGORITHM=AES256
# Alert if no successful backup is found within this many hours. Read by the
# backend health check.
# Format: integer (hours) | Required: no | Default: 26
BACKUP_MAX_AGE_HOURS=26
# Slack incoming webhook for backup success/failure notifications. # SENSITIVE
# Format: URL | Required: no
SLACK_BACKUP_WEBHOOK=

# ── API Response Cache ─────────────────────────────────────────────────────────
# All values in seconds. Omit any of these to use the defaults shown below.
# Default TTL applied to cacheable responses with no more specific rule.
# Format: integer (seconds) | Required: no | Default: 60
CACHE_TTL_DEFAULT=60
# TTL for list/collection endpoint responses.
# Format: integer (seconds) | Required: no | Default: 15
CACHE_TTL_LIST=15
# TTL for single-resource detail endpoint responses.
# Format: integer (seconds) | Required: no | Default: 30
CACHE_TTL_DETAIL=30
# TTL for the reputation leaderboard endpoint response.
# Format: integer (seconds) | Required: no | Default: 300
CACHE_TTL_LEADERBOARD=300
# TTL for indexed contract event query responses.
# Format: integer (seconds) | Required: no | Default: 15
CACHE_TTL_EVENTS=15
# TTL for reputation detail endpoint responses.
# Format: integer (seconds) | Required: no | Default: 60
CACHE_TTL_REPUTATION=60
# TTL for largely static reference-data responses.
# Format: integer (seconds) | Required: no | Default: 600
CACHE_TTL_STATIC=600

# ── Incident Response ──────────────────────────────────────────────────────────
# PagerDuty Events API v2 integration key (PagerDuty → Services → Integrations). # SENSITIVE
# Format: string | Required: no
PAGERDUTY_ROUTING_KEY=
# Slack incoming webhook URL for incident notifications. # SENSITIVE
# Format: URL | Required: no
SLACK_INCIDENT_WEBHOOK=
# Base URL used to build runbook links included in alerts.
# Format: URL | Required: no | Default: https://github.com/your-org/stellar-trust-escrow/blob/main/docs/incidents/runbooks
RUNBOOK_BASE_URL=https://github.com/your-org/stellar-trust-escrow/blob/main/docs/incidents/runbooks
# On-call rotation schedule.
# Format: JSON array of { name, email, phone?, startUtc, endUtc } | Required: no | Default: []
# Example: [{"name":"Alice","email":"alice@example.com","startUtc":"2026-01-05T00:00:00Z","endUtc":"2026-01-12T00:00:00Z"}]
ONCALL_SCHEDULE=[]

# ── Dispute Evidence Upload — IPFS ─────────────────────────────────────────────
# Public gateway used to resolve/read IPFS content by CID.
# Format: URL | Required: yes, for evidence uploads | Default: https://ipfs.io
IPFS_GATEWAY_URL=https://ipfs.io
# IPFS HTTP API endpoint used to pin/upload evidence files.
# Format: URL | Required: yes, for evidence uploads | Default: https://api.thegraph.com/ipfs/api/v0
IPFS_API_URL=https://api.thegraph.com/ipfs/api/v0

# ── ClamAV Virus Scanner ───────────────────────────────────────────────────────
# ClamAV daemon host, used to scan uploaded evidence files.
# Format: hostname | Required: yes, for evidence uploads | Default: localhost
CLAMAV_HOST=localhost
# ClamAV daemon port.
# Format: integer | Required: no | Default: 3310
CLAMAV_PORT=3310

# ── File Uploads ───────────────────────────────────────────────────────────────
# Max size of a single uploaded evidence file.
# Format: integer (bytes) | Required: no | Default: 10485760 (10MB)
MAX_FILE_SIZE=10485760
# Max number of files per evidence upload.
# Format: integer | Required: no | Default: 5
MAX_FILES=5
# Allowed MIME types for evidence uploads.
# Format: comma-separated MIME types | Required: no
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,text/plain,video/mp4

# ── WebSocket ──────────────────────────────────────────────────────────────────
# Interval between WebSocket heartbeat pings for real-time update connections.
# Format: integer (ms) | Required: no | Default: 30000
WS_HEARTBEAT_INTERVAL_MS=30000
# Max concurrent WebSocket connections accepted per instance.
# Format: integer | Required: no | Default: 100
WS_MAX_CONNECTIONS=100

# ── RPC SLA Monitor ────────────────────────────────────────────────────────────
# Comma-separated list of Soroban/Horizon RPC endpoints to monitor. Defaults to
# SOROBAN_RPC_URL if unset.
# Format: comma-separated URLs | Required: no
RPC_MONITOR_ENDPOINTS=
# Poll cadence for the RPC SLA monitor.
# Format: integer (ms) | Required: no | Default: 10000
RPC_MONITOR_POLL_INTERVAL_MS=10000
# Alert if RPC latency exceeds this value.
# Format: integer (ms) | Required: no | Default: 1500
RPC_LATENCY_THRESHOLD_MS=1500
# Alert if RPC failure rate exceeds this fraction.
# Format: decimal 0–1 | Required: no | Default: 0.02 (2%)
RPC_FAILURE_RATE_THRESHOLD=0.02
# Number of recent probes used to calculate the RPC failure rate.
# Format: integer | Required: no | Default: 50
RPC_ALERT_WINDOW=50
# Slack incoming webhook for RPC health alerts. # SENSITIVE
# Format: URL | Required: no
SLACK_RPC_WEBHOOK=

# ── IPFS / Pinata ──────────────────────────────────────────────────────────────
# Pinata JWT for authenticated pinning uploads. Required for encrypted IPFS
# uploads. # SENSITIVE
# Format: string | Required: conditional
PINATA_JWT=
# Custom Pinata dedicated gateway URL.
# Format: URL | Required: no
PINATA_GATEWAY_URL=

# ── Distributed Indexer Locking (Redlock) ─────────────────────────────────────
# Redis lock TTL — locks auto-expire if a node crashes mid-batch.
# Format: integer (ms) | Required: no | Default: 30000
INDEXER_LOCK_TTL_MS=30000
# Number of lock acquisition retries before skipping a batch.
# Format: integer | Required: no | Default: 3
INDEXER_LOCK_RETRY_COUNT=3
# Delay between lock acquisition retries.
# Format: integer (ms) | Required: no | Default: 200
INDEXER_LOCK_RETRY_DELAY_MS=200

# ── Trustchain Escrow — Protocol Config ────────────────────────────────────────
# Protocol fee in basis points (1 bps = 0.01%) charged on escrow volume.
# Format: integer (bps) | Required: no | Default: 50
TRUSTCHAIN_FEE_BPS=50
# Stellar account that receives collected protocol fees.
# Format: Stellar account ID (G...) | Required: yes
TRUSTCHAIN_TREASURY_ADDRESS=
# Max amount (in the escrow token's units) allowed for a single escrow.
# Format: number | Required: no | Default: 100000
TRUSTCHAIN_MAX_ESCROW_AMOUNT=100000
# Min amount (in the escrow token's units) allowed for a single escrow.
# Format: number | Required: no | Default: 1
TRUSTCHAIN_MIN_ESCROW_AMOUNT=1
