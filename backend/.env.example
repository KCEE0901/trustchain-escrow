# Alert email delivery configuration
# Set ALERT_EMAIL_ENABLED=true to enable outbound alert emails.
ALERT_EMAIL_ENABLED=false

# Required when ALERT_EMAIL_ENABLED=true.
# SMTP host used to deliver alert emails (e.g. smtp.example.com).
ALERT_EMAIL_SMTP_HOST=
# SMTP port. Must be a positive integer (commonly 587 or 465).
ALERT_EMAIL_SMTP_PORT=587
# SMTP username. Required when ALERT_EMAIL_SMTP_PASSWORD is set.
ALERT_EMAIL_SMTP_USER=
# SMTP password. Required when ALERT_EMAIL_SMTP_USER is set. Never commit real values.
ALERT_EMAIL_SMTP_PASSWORD=
# From address used as the alert email sender. Required when ALERT_EMAIL_ENABLED=true.
ALERT_EMAIL_FROM=
# Recipient address for alert emails. Required when ALERT_EMAIL_ENABLED=true.
ALERT_EMAIL_TO=
