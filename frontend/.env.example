NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Multi-Currency ─────────────────────────────────────────────────────────────
# Exchange rate API endpoint (default: open.er-api.com — free, no key required)
NEXT_PUBLIC_EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
# How long to cache exchange rates in the browser (ms, default 1 hour)
NEXT_PUBLIC_FX_CACHE_TTL_MS=3600000

# ── Live XLM/USD Rate (frontend/hooks/useLiveXlmRate.js) ───────────────────────
# Price API endpoint (default: CoinGecko simple price — free, no key required)
NEXT_PUBLIC_XLM_RATE_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=stellar&vs_currencies=usd
# How often to poll for a fresh rate, in ms (default: 60000 = 1 minute)
NEXT_PUBLIC_XLM_RATE_POLL_INTERVAL_MS=60000
# How long a cached rate remains valid as a fallback, in ms (default: 300000 = 5 minutes)
NEXT_PUBLIC_XLM_RATE_CACHE_TTL_MS=300000

# ── Sentry Error Tracking ──────────────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
NEXT_PUBLIC_SENTRY_RELEASE=
# Server-only — used to upload source maps during build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
