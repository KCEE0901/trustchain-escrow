NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── ReputationBadge component ──────────────────────────────────────────────────
# Base URL of the backend REST API consumed by ReputationBadge (and all API
# calls). The component fetches on-chain reputation scores via this endpoint.
# Default: http://localhost:4000 (local dev backend)
# NEXT_PUBLIC_API_URL is already declared above — no additional entry required.
#
# Stellar network the reputation contract is deployed on.
# Accepted values: "testnet" | "mainnet"
# Used by the Stellar SDK client (frontend/lib/stellar.js) to resolve the
# correct network passphrase when verifying on-chain reputation events.
# NEXT_PUBLIC_STELLAR_NETWORK is already declared above.
#
# Soroban RPC endpoint used to query reputation contract state directly.
# Testnet default: https://soroban-testnet.stellar.org
# Mainnet:         https://soroban-rpc.mainnet.stellar.gateway.fm (or your own node)
# NEXT_PUBLIC_SOROBAN_RPC_URL is already declared above.

# ── Multi-Currency ─────────────────────────────────────────────────────────────
# Exchange rate API endpoint (default: open.er-api.com — free, no key required)
NEXT_PUBLIC_EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
# How long to cache exchange rates in the browser (ms, default 1 hour)
NEXT_PUBLIC_FX_CACHE_TTL_MS=3600000

# ── Sentry Error Tracking ──────────────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
NEXT_PUBLIC_SENTRY_RELEASE=
# Server-only — used to upload source maps during build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
