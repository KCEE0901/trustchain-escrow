NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Site & WebSocket ───────────────────────────────────────────────────────────
# Canonical site URL — used for OpenGraph metadata base (default: https://stellartrustescrow.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WebSocket server URL for live escrow updates.
# If omitted, the client derives it from NEXT_PUBLIC_API_URL (http→ws, https→wss).
NEXT_PUBLIC_WS_URL=

# ── Reputation Badge ───────────────────────────────────────────────────────────
# Base URL for the backend API used by ReputationBadge.jsx and other direct REST calls.
# Defaults to http://localhost:4000 if not set.
# ReputationBadge renders score tiers (New / Fair / Good / Excellent) backed by the
# on-chain reputation service.  Thresholds are hard-coded at 100 / 250 / 500.
# Override with NEXT_PUBLIC_REPUTATION_* variables if you need custom tier values.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# ── Performance & Analytics ────────────────────────────────────────────────────
# Optional endpoint for client-side performance metrics (Web Vitals).
# Leave blank to disable analytics reporting.
NEXT_PUBLIC_ANALYTICS_URL=

# ── Multi-Currency ─────────────────────────────────────────────────────────────
# Exchange rate API endpoint (default: open.er-api.com — free, no key required)
NEXT_PUBLIC_EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
# How long to cache exchange rates in the browser (ms, default 1 hour)
NEXT_PUBLIC_FX_CACHE_TTL_MS=3600000

# ── Sentry Error Tracking ──────────────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
NEXT_PUBLIC_SENTRY_RELEASE=
# Server-only — used to upload source maps during build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
