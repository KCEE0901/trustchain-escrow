# ── EscrowCard Component ───────────────────────────────────────────────────────
# The EscrowCard component (components/EscrowCard.jsx) renders individual escrow
# summaries in the dashboard. It needs the API URL to fetch escrow details, the
# Stellar network config to link transactions to the correct explorer, and the
# contract address / RPC URL to read on-chain state directly from Soroban.
#
# Inside EscrowCard, the <CurrencyAmount> sub-component reads exchange rates via
# CurrencyContext — so the FX vars below also apply to every escrow card shown.
#
# New contributor quick reference:
#   NEXT_PUBLIC_API_URL          → backend REST base URL (EscrowCard data fetch)
#   NEXT_PUBLIC_STELLAR_NETWORK  → 'testnet' or 'mainnet' (explorer links)
#   NEXT_PUBLIC_CONTRACT_ADDRESS → deployed Soroban escrow contract ID
#   NEXT_PUBLIC_SOROBAN_RPC_URL  → Soroban JSON-RPC endpoint for on-chain reads
#   NEXT_PUBLIC_EXCHANGE_RATE_API_URL → FX rate source used by <CurrencyAmount>
#   NEXT_PUBLIC_FX_CACHE_TTL_MS  → how long <CurrencyAmount> caches FX data
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the Trustchain Escrow REST API.
# Used by EscrowCard (and all other components) to fetch data from the backend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Stellar network to target. Controls which Stellar explorer URLs are generated
# and which Soroban RPC endpoint is expected. Values: 'testnet' | 'mainnet'
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Deployed Soroban escrow contract ID.
# EscrowCard uses this to construct direct on-chain links and for contract reads.
# Leave blank during initial setup — fill in after deploying the Soroban contract.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Soroban JSON-RPC endpoint. EscrowCard reads on-chain escrow state through this.
# Testnet default shown; swap for https://soroban.stellar.org on mainnet.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Multi-Currency ─────────────────────────────────────────────────────────────
# The <CurrencyAmount> component inside EscrowCard fetches live FX rates to
# display escrow values in the user's preferred currency.
#
# Exchange rate API endpoint (default: open.er-api.com — free, no key required)
NEXT_PUBLIC_EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
# How long to cache exchange rates in the browser (ms, default 1 hour = 3600000)
# Increase this value to reduce API calls; decrease for more up-to-date rates.
NEXT_PUBLIC_FX_CACHE_TTL_MS=3600000

# ── Sentry Error Tracking ──────────────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
NEXT_PUBLIC_SENTRY_RELEASE=
# Server-only — used to upload source maps during build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
