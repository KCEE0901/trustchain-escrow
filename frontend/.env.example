NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Multi-Currency ─────────────────────────────────────────────────────────────
# Exchange rate API endpoint (default: open.er-api.com — free, no key required)
NEXT_PUBLIC_EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
# How long to cache exchange rates in the browser (ms, default 1 hour)
NEXT_PUBLIC_FX_CACHE_TTL_MS=3600000

# ── Sentry Error Tracking ──────────────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
NEXT_PUBLIC_SENTRY_RELEASE=
# Server-only — used to upload source maps during build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Live XLM Rate Hook ────────────────────────────────────────────────────────
# Base URL for the XLM/USD price API endpoint.
# Must return JSON with at minimum a numeric `price` (or `USD` / `rate`) field
# and a `timestamp` field. No path is appended — point this at the full URL.
# Example: https://api.example.com/v1/xlm-usd
NEXT_PUBLIC_XLM_PRICE_API_URL=

# How often to re-fetch the live XLM rate, in milliseconds (default: 30 000 = 30 s).
# Set to 0 to disable polling (fetch once on mount only).
NEXT_PUBLIC_XLM_POLL_INTERVAL_MS=30000

# Age threshold in milliseconds after which the cached rate is considered stale
# and the UI should display a warning (default: 120 000 = 2 minutes).
NEXT_PUBLIC_XLM_RATE_STALE_THRESHOLD_MS=120000

# Per-request timeout in milliseconds for XLM price API calls (default: 10 000 = 10 s).
# Requests that exceed this are aborted and the previous rate is retained.
NEXT_PUBLIC_XLM_API_TIMEOUT_MS=10000
